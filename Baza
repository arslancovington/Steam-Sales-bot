<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>P2P Skin Market</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    
    <!-- СТИЛИ (CSS) -->
    <style>
        :root {
            --bg-color: #0b1110;
            --neon-green: #7cfc00;
            --neon-cyan: #00ffff;
            --card-bg: rgba(20, 30, 25, 0.7);
            --text-main: #ffffff;
            --text-muted: #889988;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        /* Шапка */
        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
            background: rgba(11, 17, 16, 0.9);
            backdrop-filter: blur(5px);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .bot-profile { display: flex; align-items: center; gap: 10px; }
        .bot-icon { font-size: 24px; }
        .bot-info { display: flex; flex-direction: column; }
        .bot-name { font-weight: bold; color: var(--text-main); }
        .bot-status { color: var(--neon-green); font-size: 12px; font-weight: bold; }

        /* Виджет баланса */
        .balance-widget {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 5px 10px;
            border-radius: 8px;
            border: 1px solid var(--neon-green);
            box-shadow: 0 0 10px rgba(124, 252, 0, 0.2);
        }
        .add-funds-btn {
            background: transparent;
            color: var(--neon-green);
            border: none;
            font-size: 20px;
            cursor: pointer;
        }

        /* Скрытые вкладки */
        .tab { display: none; padding: 15px; padding-bottom: 80px; }
        .tab.active { display: block; }

        /* Текст и заголовки */
        .neon-text { color: var(--text-main); text-shadow: 0 0 5px var(--neon-green); margin-top: 0;}
        .vip-title { color: var(--neon-cyan); text-shadow: 0 0 5px var(--neon-cyan); margin-top: 0;}
        .section-title { margin-top: 20px; border-bottom: 1px solid #333; padding-bottom: 5px; }

        /* Форма Trade URL */
        .trade-url-box {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            padding: 10px;
            border-radius: 8px;
        }
        .trade-url-box input {
            flex: 1;
            padding: 10px;
            background: #111;
            border: 1px solid #333;
            color: white;
            border-radius: 6px;
        }
        .btn-cyan {
            background: transparent;
            color: var(--neon-cyan);
            border: 1px solid var(--neon-cyan);
            padding: 10px 15px;
            border-radius: 6px;
            cursor: pointer;
        }

        /* Карточки */
        .grid-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
        .horizontal-scroll { display: flex; overflow-x: auto; gap: 15px; padding-bottom: 10px; }

        .card {
            background: var(--card-bg);
            padding: 15px;
            border-radius: 12px;
            position: relative;
            backdrop-filter: blur(4px);
        }

        .card h4 { margin: 10px 0 5px 0; font-size: 14px; color: var(--text-main); }
        .wear { font-size: 11px; color: var(--text-muted); margin-bottom: 10px; }
        .price { font-size: 16px; font-weight: bold; color: var(--text-main); }
        .skin-image { font-size: 40px; text-align: center; margin-bottom: 10px;}

        /* Эффекты свечения границ */
        .neon-border-green {
            border: 1px solid var(--neon-green);
            box-shadow: 0 0 15px rgba(124, 252, 0, 0.15);
        }
        .neon-border-cyan {
            border: 1px solid var(--neon-cyan);
            box-shadow: 0 0 15px rgba(0, 255, 255, 0.2);
        }

        /* Большие кнопки снизу (Оценить / Продать) */
        .action-buttons { display: flex; gap: 10px; margin-top: 20px; }
        .btn-dark-neon {
            flex: 1;
            background: transparent;
            border: 1px solid var(--neon-cyan);
            color: var(--text-main);
            padding: 15px;
            border-radius: 8px;
            box-shadow: inset 0 0 10px rgba(0, 255, 255, 0.2);
            cursor: pointer;
            font-size: 12px;
            font-weight: bold;
        }
        .btn-green-glow {
            flex: 1;
            background: var(--neon-green);
            border: none;
            color: #000;
            font-weight: bold;
            padding: 15px;
            border-radius: 8px;
            box-shadow: 0 0 20px rgba(124, 252, 0, 0.6);
            cursor: pointer;
            font-size: 12px;
        }

        /* Нижняя навигация */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            width: 100%;
            background: rgba(11, 17, 16, 0.95);
            backdrop-filter: blur(10px);
            display: flex;
            justify-content: space-around;
            padding: 15px 0;
            border-top: 1px solid rgba(124, 252, 0, 0.3);
            z-index: 100;
        }
        .nav-item { 
            background: none; 
            border: none; 
            font-size: 26px; 
            filter: grayscale(100%); 
            opacity: 0.5; 
            transition: 0.3s; 
            cursor: pointer;
        }
        .active-nav { 
            filter: none; 
            opacity: 1; 
            text-shadow: 0 0 10px var(--neon-cyan); 
            transform: scale(1.1); 
        }
    </style>
</head>
<body>

    <!-- Шапка -->
    <header class="top-bar">
        <div class="bot-profile">
            <div class="bot-icon">🤖</div>
            <div class="bot-info">
                <span class="bot-name">steam sales ✔️</span>
                <span class="bot-status">Активен</span>
            </div>
        </div>
        <div class="balance-widget">
            <span id="user-balance">~$154.45</span>
            <button class="add-funds-btn" onclick="topUp()">+</button>
        </div>
    </header>

    <!-- Основной контент -->
    <main class="content-area">
        
        <!-- 🏠 Вкладка: ПРОФИЛЬ -->
        <section id="tab-profile" class="tab">
            <h2 class="neon-text">Твой Профиль</h2>
            <div class="card neon-border-green">
                <p>Рейтинг: ⭐ 4.9</p>
                <p>Успешных сделок: 142</p>
            </div>
        </section>

        <!-- 📦💲 Вкладка: ИНВЕНТАРЬ -->
        <section id="tab-inventory" class="tab">
            <div class="trade-url-box neon-border-green">
                <input type="text" id="steam-url" placeholder="Введи Steam Trade URL">
                <button class="btn-cyan" onclick="saveTradeUrl()">Сохранить</button>
            </div>
            <h3 class="neon-text">Твои предметы</h3>
            <div id="user-inventory" class="grid-layout">
                <p style="color: #889988;">Инвентарь пока пуст. Привяжите Trade URL.</p>
            </div>
        </section>

        <!-- 🤝 Вкладка: P2P ТРЕЙД -->
        <section id="tab-market" class="tab active">
            
            <!-- VIP Раздел -->
            <div class="vip-section">
                <h3 class="vip-title">👑 VIP ПРЕДЛОЖЕНИЯ</h3>
                <div id="vip-list" class="horizontal-scroll">
                    <div class="card neon-border-cyan" style="min-width: 150px;">
                        <div class="skin-image">🔪</div>
                        <h4>Butterfly Knife | Lore</h4>
                        <p class="wear">Exterior: FN</p>
                        <div class="price">$1200.00</div>
                    </div>
                </div>
            </div>

            <!-- Обычные объявления -->
            <h3 class="section-title">🤝 ВСЕ ПРЕДМЕТЫ</h3>
            <div id="market-list" class="grid-layout">
                <div class="card neon-border-green">
                    <div class="skin-image">🔫</div>
                    <h4>AK-47 | Hyper Beast</h4>
                    <p class="wear">Exterior: 100%</p>
                    <div class="price">$18.20</div>
                </div>
                <div class="card neon-border-green">
                    <div class="skin-image">🔪</div>
                    <h4>M9 Bayonet | Fade</h4>
                    <p class="wear">Exterior: Factory New</p>
                    <div class="price">$120.50</div>
                </div>
            </div>

            <!-- Кнопки действий снизу -->
            <div class="action-buttons">
                <button class="btn-dark-neon">ОЦЕНИТЬ ИНВЕНТАРЬ</button>
                <button class="btn-green-glow">ПРОДАТЬ (+3%)</button>
            </div>
        </section>
            <!-- Модальное окно для продажи -->
        <div id="sale-modal" class="modal-overlay">
            <div class="modal-content neon-border-green">
                <h3 class="neon-text">Продажа предмета</h3>
                <p id="modal-item-name" style="color: var(--text-muted); font-size: 14px;">Название предмета</p>
                
                <div class="price-input-container">
                    <span class="currency-symbol">$</span>
                    <input type="number" id="sale-price-input" placeholder="0.00" step="0.01">
                </div>
                <p style="font-size: 11px; color: #889988; margin-bottom: 15px;">Комиссия платформы (3%): будет удержана при успешной сделке.</p>

                <div class="modal-buttons">
                    <button class="btn-dark-neon" onclick="closeModal()">Отмена</button>
                    <button class="btn-green-glow" onclick="confirmSale()">Выставить</button>
                </div>
            </div>
        </div>

</main>

    <!-- Нижнее меню навигации -->
    <nav class="bottom-nav">
        <!-- В функции передаем ID вкладки и сам элемент кнопки (this) -->
        <button class="nav-item" onclick="switchTab('profile', this)">🏠</button>
        <button class="nav-item" onclick="switchTab('inventory', this)">📦💲</button>
        <button class="nav-item active-nav" onclick="switchTab('market', this)">🤝</button>
    </nav>

    <!-- СКРИПТЫ (JS) -->
    <script>
        // Инициализация Telegram
        if (window.Telegram && window.Telegram.WebApp) {
            const tg = window.Telegram.WebApp;
            tg.expand(); 
        }

        // Логика переключения вкладок
        function switchTab(tabId, btnElement) {
            // 1. Скрываем все вкладки
            document.querySelectorAll('.tab').forEach(tab => {
                tab.classList.remove('active');
            });
            
            // 2. Снимаем свечение со всех кнопок
            document.querySelectorAll('.nav-item').forEach(btn => {
                btn.classList.remove('active-nav');
            });
            
            // 3. Показываем нужную вкладку
            document.getElementById(`tab-${tabId}`).classList.add('active');
            
            // 4. Подсвечиваем нажатую кнопку
            btnElement.classList.add('active-nav');
        }

        function topUp() {
            alert("Открытие шлюза оплаты...");
        }

        function saveTradeUrl() {
            let url = document.getElementById('steam-url').value;
            if(url.includes('tradeoffer')) {
                alert("Trade URL успешно сохранен!");
            } else {
                alert("Ошибка! Введите корректную ссылку.");
            }
        }
           // Функция выставления предмета на продажу
        function createSale(itemName) {
            // Запрашиваем у пользователя цену (позже сделаем красивое модальное окно)
            let price = prompt(`Введи цену продажи для:\n${itemName} ($)`);
            
            if (price && !isNaN(price)) {
                alert(`Успешно!\nПредмет ${itemName} выставлен на маркет за $${price}.`);
                // В будущем здесь будет код отправки данных на наш Python-сервер
            } else if (price) {
                alert("Ошибка! Введи корректную сумму цифрами.");
            }
        }
</script>
</body>
</html>
